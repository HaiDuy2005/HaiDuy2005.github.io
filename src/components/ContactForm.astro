---
import { siteConfig } from '../data/siteConfig';
const { author } = siteConfig;
---

<div class="card p-6">

  <div class="space-y-5">
    <div>
      <p class="section-label mb-1">// Direct Comm</p>
      <h3 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:800;color:var(--text-high);">
        Gửi thông điệp trực tiếp
      </h3>
      <p style="font-size:13px;color:var(--text-low);margin-top:4px;line-height:1.65;">
        Website chạy tĩnh trên GitHub Pages — form dưới đây sẽ mở ứng dụng mail của bạn với nội dung đã điền sẵn.
      </p>
    </div>

    <!-- Email copy row -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 p-4 rounded-lg"
         style="background:var(--bg-raised);border:1px solid var(--border);">
      <div class="flex items-center gap-3 flex-1 min-w-0">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0"
             style="background:var(--bg-card);border:1px solid var(--border);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
               style="color:var(--cyan);">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <span id="email-text"
              style="font-family:var(--font-mono);font-size:13px;color:var(--text-high);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
          {author.email}
        </span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button id="copy-email" type="button" class="btn-ghost" style="padding:7px 14px;font-size:12px;">
          Copy
        </button>
        <a href={`mailto:${author.email}?subject=Trao đổi cùng Hải Duy`}
           class="btn-primary" style="padding:7px 14px;font-size:12px;">
          Gửi Email ↗
        </a>
      </div>
    </div>

    <!-- Quick form -->
    <form id="quick-form" class="space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="space-y-1">
          <label for="f-name" class="section-label">Tên / Đơn vị</label>
          <input id="f-name" type="text" required placeholder="Nguyễn Văn A"
                 style="width:100%;padding:9px 12px;border-radius:8px;background:var(--bg-base);border:1px solid var(--border);color:var(--text-high);font-size:13px;outline:none;"
                 onfocus="this.style.borderColor='var(--cyan)'" onblur="this.style.borderColor='var(--border)'"/>
        </div>
        <div class="space-y-1">
          <label for="f-topic" class="section-label">Chủ đề</label>
          <select id="f-topic"
                  style="width:100%;padding:9px 12px;border-radius:8px;background:var(--bg-base);border:1px solid var(--border);color:var(--text-high);font-size:13px;outline:none;">
            <option>Cơ hội thực tập IT / Web</option>
            <option>Hợp tác dự án AI / Cloud</option>
            <option>Giao lưu âm nhạc / Hip-hop</option>
            <option>Khác</option>
          </select>
        </div>
      </div>
      <div class="space-y-1">
        <label for="f-msg" class="section-label">Nội dung</label>
        <textarea id="f-msg" rows="4" required placeholder="Mô tả ngắn điều bạn muốn trao đổi..."
                  style="width:100%;padding:9px 12px;border-radius:8px;background:var(--bg-base);border:1px solid var(--border);color:var(--text-high);font-size:13px;outline:none;resize:vertical;"
                  onfocus="this.style.borderColor='var(--cyan)'" onblur="this.style.borderColor='var(--border)'"></textarea>
      </div>
      <button type="submit" class="btn-primary w-full justify-center" style="font-size:13px;">
        Mở Email Client →
      </button>
    </form>
  </div>
</div>

<script>
  const emailElem = document.getElementById('email-text');
  const copyBtn   = document.getElementById('copy-email');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailElem?.textContent?.trim() || '');
      if (copyBtn) { copyBtn.textContent = 'Copied!'; }
      setTimeout(() => { if (copyBtn) copyBtn.textContent = 'Copy'; }, 2000);
    } catch {}
  });

  document.getElementById('quick-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const email = emailElem?.textContent?.trim() || '';
    const name  = (document.getElementById('f-name') as HTMLInputElement)?.value;
    const topic = (document.getElementById('f-topic') as HTMLSelectElement)?.value;
    const msg   = (document.getElementById('f-msg') as HTMLTextAreaElement)?.value;
    const sub   = encodeURIComponent(`[Duyverse] ${topic} - ${name}`);
    const body  = encodeURIComponent(`Xin chào Hải Duy,\n\nTôi là ${name}.\n\n${msg}\n\nTrân trọng,\n${name}`);
    location.href = `mailto:${email}?subject=${sub}&body=${body}`;
  });
</script>
