---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filtered.length > 0 && (
  <nav>
    <p class="section-label mb-3">Mục lục</p>
    <ul class="space-y-1.5" style="font-family:var(--font-mono);font-size:12px;">
      {filtered.map(h => (
        <li>
          <a href={`#${h.slug}`}
             data-slug={h.slug}
             class="toc-link block leading-snug transition-colors"
             style={`color:var(--text-low);padding-left:${h.depth === 3 ? '14px' : '0'};`}
             onmouseover="this.style.color='var(--text-high)'" onmouseout="this.style.color=this.dataset.active?'var(--cyan)':'var(--text-low)'">
            {h.depth === 3 ? '↳ ' : ''}{h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.getAttribute('id');
        links.forEach(l => {
          const active = l.dataset.slug === id;
          l.style.color = active ? 'var(--cyan)' : 'var(--text-low)';
          if (active) l.dataset.active = '1';
          else delete l.dataset.active;
        });
      }
    });
  }, { rootMargin: '-72px 0px -60% 0px' });

  document.querySelectorAll('h2[id],h3[id]').forEach(h => observer.observe(h));
</script>
