---
// CyberBackground — subtle ambient glow, animated moving orbs & mouse-follow lighting
---
<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
  <!-- Ambient floating orbs with smooth motion -->
  <div class="orb w-[540px] h-[540px] -top-36 -left-36 animate-orb-1"
       style="background: radial-gradient(circle, rgba(34,211,238,0.08) 0%, transparent 70%);"></div>
  <div class="orb w-[640px] h-[640px] top-1/4 -right-40 animate-orb-2"
       style="background: radial-gradient(circle, rgba(167,139,250,0.07) 0%, transparent 70%);"></div>
  <div class="orb w-[460px] h-[460px] -bottom-24 left-1/4 animate-pulse-glow"
       style="background: radial-gradient(circle, rgba(163,230,53,0.05) 0%, transparent 70%);"></div>

  <!-- Mouse Spotlight Glow (dynamically positioned by JS on desktop) -->
  <div id="mouse-glow"
       class="hidden md:block fixed w-[600px] h-[600px] rounded-full pointer-events-none transition-opacity duration-500 opacity-0"
       style="background: radial-gradient(circle, rgba(34,211,238,0.035) 0%, transparent 65%); transform: translate(-50%, -50%);">
  </div>

  <!-- Ultra-subtle dot grid -->
  <div class="absolute inset-0 bg-grid opacity-100
              [mask-image:radial-gradient(ellipse_85%_85%_at_50%_50%,black_40%,transparent_100%)]">
  </div>
</div>

<script>
  // Mouse interactive spotlight
  const glow = document.getElementById('mouse-glow');
  if (glow && window.matchMedia('(pointer: fine)').matches) {
    let mouseX = -1000;
    let mouseY = -1000;
    let currentX = -1000;
    let currentY = -1000;
    let isMoving = false;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!isMoving) {
        glow.style.opacity = '1';
        isMoving = true;
      }
    });

    window.addEventListener('mouseleave', () => {
      glow.style.opacity = '0';
      isMoving = false;
    });

    // Smooth lerp follow
    function animateGlow() {
      currentX += (mouseX - currentX) * 0.12;
      currentY += (mouseY - currentY) * 0.12;
      glow.style.left = `${currentX}px`;
      glow.style.top = `${currentY}px`;
      requestAnimationFrame(animateGlow);
    }
    animateGlow();
  }
</script>
