---
// CyberBackground — subtle ambient glow, no clutter
---
<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
  <!-- Ambient orbs -->
  <div class="orb w-[520px] h-[520px] -top-48 -left-32 animate-orb"
       style="background: radial-gradient(circle, rgba(34,211,238,0.07) 0%, transparent 70%);"></div>
  <div class="orb w-[600px] h-[600px] top-1/3 -right-48 animate-orb"
       style="background: radial-gradient(circle, rgba(167,139,250,0.06) 0%, transparent 70%); animation-delay:-5s;"></div>
  <div class="orb w-[400px] h-[400px] bottom-0 left-1/3 animate-pulse-glow"
       style="background: radial-gradient(circle, rgba(163,230,53,0.04) 0%, transparent 70%);"></div>

  <!-- Ultra-subtle dot grid -->
  <div class="absolute inset-0 bg-grid opacity-100
              [mask-image:radial-gradient(ellipse_80%_80%_at_50%_50%,black_40%,transparent_100%)]">
  </div>
</div>
