---
// CyberBackground.astro - Tech grid with animated glow orbs
---

<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
  <!-- Radial Neon Orbs -->
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-cyan-500/10 blur-[120px] animate-pulse-glow"></div>
  <div class="absolute top-1/3 -right-32 w-[30rem] h-[30rem] rounded-full bg-purple-600/10 blur-[150px] animate-float-orb"></div>
  <div class="absolute -bottom-32 left-1/3 w-96 h-96 rounded-full bg-emerald-500/5 blur-[120px]"></div>

  <!-- Technical Grid Overlay with Radial Vignette -->
  <div 
    class="absolute inset-0 cyber-grid-pattern opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_85%)]"
  ></div>

  <!-- Subtle Horizontal Scanline Accent -->
  <div class="absolute inset-x-0 h-px bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent top-0 animate-pulse"></div>
</div>
