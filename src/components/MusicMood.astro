---
import { siteConfig } from '../data/siteConfig';
const { musicMood } = siteConfig;
---

<div class="card p-5" style="background:var(--bg-raised);">
  <!-- Header row -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--lime);"></span>
      <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);letter-spacing:0.08em;">
        AUDIO MOOD
      </span>
    </div>
    <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
      {musicMood.currentVibe}
    </span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">

    <!-- Track info -->
    <div class="flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-lg flex items-center justify-center shrink-0"
           style="background:var(--bg-card);border:1px solid var(--border);">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
             style="color:var(--cyan);">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M9 19V6l12-3v13M9 19c0 1.1-1.34 2-3 2s-3-.9-3-2 1.34-2 3-2 3 .9 3 2zm12-3c0 1.1-1.34 2-3 2s-3-.9-3-2 1.34-2 3-2 3 .9 3 2z"/>
        </svg>
      </div>
      <div>
        <p style="font-family:var(--font-heading);font-size:14px;font-weight:600;color:var(--text-high);">
          {musicMood.featuredTrack.title}
        </p>
        <p style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
          {musicMood.featuredTrack.artist}
        </p>
      </div>
    </div>

    <!-- Visualizer bars + Play button -->
    <div class="flex items-center gap-4">
      <!-- EQ bars -->
      <div id="eq-bars" class="flex items-end gap-0.5 h-6 opacity-40 transition-opacity duration-300"
           style="transform-origin:bottom;">
        {[14, 22, 8, 28, 16, 20, 10].map((h, i) => (
          <div class="w-1.5 rounded-sm"
               style={`height:${h}px;background:${i % 3 === 0 ? 'var(--cyan)' : i % 3 === 1 ? 'var(--violet)' : 'var(--lime)'};transition:height 0.15s;`}>
          </div>
        ))}
      </div>

      <button id="music-play-btn" type="button" aria-label="Play ambient beat"
              class="btn-ghost" style="padding:7px 16px;font-size:12px;gap:6px;">
        <svg id="ico-play" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <svg id="ico-pause" class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <rect x="6" y="4" width="4" height="16"/>
          <rect x="14" y="4" width="4" height="16"/>
        </svg>
        <span id="play-label">Play Vibe</span>
      </button>
    </div>
  </div>

  <!-- Quote -->
  <p class="mt-4 pt-4 text-[12px] italic leading-relaxed"
     style="border-top:1px solid var(--border);color:var(--text-low);">
    {musicMood.featuredTrack.quote}
  </p>
</div>

<script>
  let audioCtx: AudioContext | null = null;
  let playing = false;
  let timer: any;

  const btn    = document.getElementById('music-play-btn');
  const iPlay  = document.getElementById('ico-play');
  const iPause = document.getElementById('ico-pause');
  const label  = document.getElementById('play-label');
  const bars   = document.getElementById('eq-bars')?.children;

  const chords = [
    [174.61, 207.65, 261.63, 311.13],
    [138.59, 174.61, 207.65, 261.63],
    [207.65, 261.63, 311.13, 415.30],
    [155.56, 196.00, 233.08, 311.13],
  ];
  let ci = 0;

  function playNote(freq: number, delay: number) {
    if (!audioCtx) return;
    const osc  = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const lpf  = audioCtx.createBiquadFilter();
    lpf.type = 'lowpass';
    lpf.frequency.value = 700;
    osc.type = 'triangle';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.001, audioCtx.currentTime + delay);
    gain.gain.exponentialRampToValueAtTime(0.035, audioCtx.currentTime + delay + 0.12);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + delay + 0.9);
    osc.connect(lpf); lpf.connect(gain); gain.connect(audioCtx.destination);
    osc.start(audioCtx.currentTime + delay);
    osc.stop(audioCtx.currentTime + delay + 1);
  }

  function loop() {
    if (!playing) return;
    chords[ci].forEach((f, i) => playNote(f, i * 0.07));
    ci = (ci + 1) % chords.length;
    if (bars) {
      Array.from(bars).forEach(b => {
        (b as HTMLElement).style.height = (Math.random() * 22 + 5) + 'px';
      });
    }
    timer = setTimeout(loop, 1600);
  }

  btn?.addEventListener('click', () => {
    if (!playing) {
      if (!audioCtx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        audioCtx = new AC();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      playing = true;
      iPlay?.classList.add('hidden');
      iPause?.classList.remove('hidden');
      if (label) label.textContent = 'Stop';
      document.getElementById('eq-bars')?.style.setProperty('opacity', '1');
      loop();
    } else {
      playing = false;
      clearTimeout(timer);
      iPlay?.classList.remove('hidden');
      iPause?.classList.add('hidden');
      if (label) label.textContent = 'Play Vibe';
      document.getElementById('eq-bars')?.style.setProperty('opacity', '0.4');
      if (bars) Array.from(bars).forEach((b, i) => {
        (b as HTMLElement).style.height = [14,22,8,28,16,20,10][i] + 'px';
      });
    }
  });
</script>
