---
import { siteConfig } from '../data/siteConfig';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (path: string) => path === '/' ? `${baseUrl}/` || '/' : `${baseUrl}${path}`;
---

<footer style="margin-top:auto;border-top:1px solid var(--border);background:var(--bg-base);">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-10">

      <!-- Brand column -->
      <div class="sm:col-span-5 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center"
               style="background:var(--bg-card);border:1px solid rgba(34,211,238,0.2);">
            <span style="font-family:var(--font-mono);color:var(--cyan);font-weight:700;font-size:15px;">D</span>
          </div>
          <span style="font-family:var(--font-heading);font-weight:800;font-size:15px;color:var(--text-high);">
            DUY<span style="color:var(--violet);">VERSE</span>
          </span>
        </div>

        <p style="font-size:13px;color:var(--text-low);line-height:1.7;max-width:30ch;">
          {siteConfig.author.bio}
        </p>

        <!-- Socials -->
        <div class="flex items-center gap-3 pt-1">
          <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer"
             class="btn-ghost" style="padding:7px 14px;font-size:12px;">
            GitHub ↗
          </a>
          <a href={siteConfig.author.linkedin} target="_blank" rel="noopener noreferrer"
             class="btn-ghost" style="padding:7px 14px;font-size:12px;">
            LinkedIn ↗
          </a>
        </div>
      </div>

      <!-- Spacer -->
      <div class="hidden sm:block sm:col-span-1"></div>

      <!-- Navigation -->
      <div class="sm:col-span-3">
        <p class="section-label mb-4">Navigation</p>
        <ul class="space-y-2">
          {siteConfig.navigation.map(item => (
            <li>
              <a href={h(item.href)}
                 style="font-family:var(--font-mono);font-size:13px;color:var(--text-low);"
                 class="hover:text-white transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="sm:col-span-3">
        <p class="section-label mb-4">Contact</p>
        <ul class="space-y-2">
          <li>
            <a href={`mailto:${siteConfig.author.email}`}
               style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
               class="hover:text-white transition-colors break-all">
              {siteConfig.author.email}
            </a>
          </li>
          <li>
            <div class="flex items-center gap-1.5 mt-3" style="font-size:12px;font-family:var(--font-mono);">
              <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--lime);display:inline-block;"></span>
              <span style="color:var(--lime);">Open to Internship</span>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3"
         style="border-top:1px solid var(--border);">
      <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
        © 2026 Duyverse. Built with Astro on GitHub Pages.
      </span>
      <div class="flex items-center gap-3" style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
        <span style="color:var(--cyan);">Astro 7</span>
        <span>·</span>
        <span style="color:var(--violet);">TypeScript</span>
        <span>·</span>
        <span style="color:var(--lime);">Static SSG</span>
      </div>
    </div>
  </div>
</footer>
