---
import Tag from './Tag.astro';
import { formatDate, getReadingTime } from '../utils/readingTime';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags: string[];
      cover?: string;
      author?: string;
    };
  };
}
const { post } = Astro.props;
const { data, id, body } = post;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailUrl = `${baseUrl}/posts/${id}`;
const readingTime = getReadingTime(body);
---

<article class="card card-interactive group flex flex-col overflow-hidden h-full">

  <!-- Cover image -->
  <div class="relative w-full aspect-[2/1] overflow-hidden"
       style="background:var(--bg-raised);border-bottom:1px solid var(--border);">
    {data.cover
      ? <img src={data.cover} alt={data.title} loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"/>
      : <div class="w-full h-full flex items-center justify-center"
             style="background:linear-gradient(135deg,var(--bg-card) 0%,var(--bg-base) 100%);">
          <span style="font-family:var(--font-mono);color:var(--violet);opacity:0.3;font-size:24px;font-weight:700;">
            {data.category}
          </span>
        </div>
    }
    <!-- Category pill -->
    <div class="absolute top-3 left-3">
      <span class="pill" style="background:rgba(7,9,15,0.85);backdrop-filter:blur(8px);color:var(--violet);border-color:rgba(167,139,250,0.2);">
        {data.category}
      </span>
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5 gap-3">

    <!-- Meta: date + read time -->
    <div class="flex items-center gap-2" style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
      <span>{formatDate(data.pubDate)}</span>
      <span>·</span>
      <span style="color:var(--cyan);">{readingTime}</span>
    </div>

    <!-- Title -->
    <h3 class="text-[15px] font-semibold leading-snug line-clamp-2 group-hover:text-[var(--violet)] transition-colors duration-200"
        style="font-family:var(--font-heading);color:var(--text-high);">
      <a href={detailUrl} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-[13px] leading-relaxed line-clamp-3" style="color:var(--text-low);">
      {data.description}
    </p>

    <!-- Tags + Read link -->
    <div class="mt-auto pt-3 flex items-center justify-between"
         style="border-top:1px solid var(--border);">
      <div class="flex flex-wrap gap-1.5">
        {data.tags.slice(0, 3).map(t => <Tag text={t} variant="violet" />)}
      </div>
      <a href={detailUrl}
         class="text-[12px] font-mono font-medium flex items-center gap-1 transition-all duration-200 z-10 relative shrink-0 ml-2 group/btn"
         style="color:var(--text-low);"
         onmouseover="this.style.color='var(--violet)'" onmouseout="this.style.color='var(--text-low)'">
        <span>Đọc</span>
        <span class="group-hover/btn:translate-x-1 transition-transform duration-200">→</span>
      </a>
    </div>
  </div>
</article>
