---
import Tag from './Tag.astro';
import { formatDate, getReadingTime } from '../utils/readingTime';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags: string[];
      cover?: string;
      author?: string;
    };
  };
}

const { post } = Astro.props;
const { data, id, body } = post;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailUrl = `${baseUrl}/posts/${id}`;
const readingTime = getReadingTime(body);
---

<article class="group relative flex flex-col rounded-xl bg-[#111522]/90 border border-[#1F263B] hover:border-purple-500/50 hover:shadow-[0_10px_30px_-10px_rgba(139,92,246,0.2)] transition-all duration-300 overflow-hidden">
  
  <!-- Cover Image Header -->
  <div class="relative w-full aspect-[2/1] overflow-hidden bg-[#0A0D17] border-b border-[#1F263B]">
    {data.cover ? (
      <img 
        src={data.cover} 
        alt={data.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-purple-950/40 via-[#111522] to-cyan-950/30">
        <span class="font-mono text-purple-400/40 text-2xl font-bold tracking-widest">{data.category}</span>
      </div>
    )}

    <!-- Category Floating Badge -->
    <div class="absolute top-3 left-3">
      <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold uppercase tracking-wider bg-[#080A12]/85 backdrop-blur-md border border-purple-500/40 text-purple-300 shadow">
        {data.category}
      </span>
    </div>
  </div>

  <!-- Content Section -->
  <div class="flex-1 p-5 sm:p-6 flex flex-col justify-between space-y-4">
    
    <div>
      <!-- Metadata Row: Date & Reading Time -->
      <div class="flex items-center gap-3 text-xs font-mono text-gray-400 mb-2.5">
        <span>{formatDate(data.pubDate)}</span>
        <span>•</span>
        <span class="text-cyan-400">{readingTime}</span>
      </div>

      <h3 class="text-xl font-heading font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2">
        <a href={detailUrl} class="focus:outline-none">
          <span class="absolute inset-0 z-0 pointer-events-none"></span>
          {data.title}
        </a>
      </h3>

      <p class="mt-2.5 text-sm text-gray-400 line-clamp-3 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Tags & Action -->
    <div class="pt-4 border-t border-[#1F263B]/70 flex items-center justify-between z-10 relative">
      <div class="flex flex-wrap gap-1.5">
        {data.tags.slice(0, 3).map((tag) => (
          <Tag text={tag} size="sm" variant="purple" />
        ))}
      </div>

      <a 
        href={detailUrl}
        class="text-xs font-mono text-purple-400 hover:text-purple-300 flex items-center gap-1 font-semibold group/btn ml-2 shrink-0"
      >
        <span>Đọc bài</span>
        <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
      </a>
    </div>

  </div>
</article>
