---
// AudioVisualizer.astro - Real-time HTML5 Canvas Audio Visualizer for the Lab
---

<div class="card p-5 sm:p-6 space-y-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--lime);"></span>
        <h3 style="font-family:var(--font-heading);font-size:15px;font-weight:700;color:var(--text-high);">
          Audio Spectrum Visualizer
        </h3>
      </div>
      <p style="font-family:var(--font-mono);font-size:11.5px;color:var(--text-low);margin-top:2px;">
        Web Audio API AnalyserNode · Phân tích tần số FFT thời gian thực
      </p>
    </div>

    <!-- Controls -->
    <div class="flex items-center gap-2.5">
      <select
        id="visualizer-style"
        class="card"
        style="padding:6px 12px;font-family:var(--font-mono);font-size:11.5px;color:var(--text-mid);background:var(--bg-raised);border-color:var(--border-mid);cursor:pointer;outline:none;"
      >
        <option value="bars">Spectrum Bars</option>
        <option value="wave">Oscilloscope Wave</option>
        <option value="circle">Cyber Ring</option>
      </select>

      <button
        id="lab-audio-toggle"
        type="button"
        class="btn-primary"
        style="padding:7px 16px;font-size:12px;gap:6px;"
      >
        <svg id="lab-play-ico" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg id="lab-stop-ico" class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <rect x="6" y="6" width="12" height="12"></rect>
        </svg>
        <span id="lab-audio-status">Kích hoạt Audio</span>
      </button>
    </div>
  </div>

  <!-- Canvas Visualizer Screen -->
  <div class="relative w-full rounded-lg overflow-hidden flex items-center justify-center"
       style="height:230px;background:var(--bg-base);border:1px solid var(--border);">
    <canvas id="audio-canvas" class="w-full h-full block"></canvas>
    <div id="canvas-overlay-text" class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none p-4"
         style="background:rgba(7,9,15,0.7);backdrop-filter:blur(3px);">
      <span class="pill pill-cyan mb-2" style="font-size:10px;">IDLE MODE</span>
      <span style="font-size:13px;color:var(--text-mid);max-width:36ch;line-height:1.6;">
        Nhấn "Kích hoạt Audio" để bắt đầu phát chuỗi âm thanh và xem sóng phân tích
      </span>
    </div>
  </div>
</div>

<script>
  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let isRunning = false;
  let animId: number = 0;
  let synthInterval: any = null;

  const btn = document.getElementById('lab-audio-toggle');
  const playIco = document.getElementById('lab-play-ico');
  const stopIco = document.getElementById('lab-stop-ico');
  const statusTxt = document.getElementById('lab-audio-status');
  const overlay = document.getElementById('canvas-overlay-text');
  const styleSelect = document.getElementById('visualizer-style') as HTMLSelectElement;
  const canvas = document.getElementById('audio-canvas') as HTMLCanvasElement;
  const ctx = canvas ? canvas.getContext('2d') : null;

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * (window.devicePixelRatio || 1);
    canvas.height = rect.height * (window.devicePixelRatio || 1);
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  // Procedural Scale
  const scale = [130.81, 146.83, 164.81, 196.00, 220.00, 261.63, 293.66, 329.63, 392.00, 440.00];
  let step = 0;

  function triggerSynthBeat() {
    if (!audioCtx || !analyser || !isRunning) return;

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    if (step % 4 === 0) {
      const kickOsc = audioCtx.createOscillator();
      const kickGain = audioCtx.createGain();
      kickOsc.frequency.setValueAtTime(130, audioCtx.currentTime);
      kickOsc.frequency.exponentialRampToValueAtTime(32, audioCtx.currentTime + 0.16);
      kickGain.gain.setValueAtTime(0.25, audioCtx.currentTime);
      kickGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.18);
      kickOsc.connect(kickGain);
      kickGain.connect(analyser);
      kickGain.connect(audioCtx.destination);
      kickOsc.start();
      kickOsc.stop(audioCtx.currentTime + 0.18);
    }

    const freq = scale[Math.floor(Math.random() * scale.length)];
    osc.type = (step % 2 === 0) ? 'sawtooth' : 'triangle';
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

    gain.gain.setValueAtTime(0.001, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.04, audioCtx.currentTime + 0.05);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.35);

    osc.connect(gain);
    gain.connect(analyser);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime + 0.38);
    step++;
  }

  function draw() {
    if (!ctx || !canvas || !analyser) return;
    animId = requestAnimationFrame(draw);

    const bufferLength = analyser.frequencyBinCount;
    const dataArray = new Uint8Array(bufferLength);
    const style = styleSelect?.value || 'bars';

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (style === 'bars') {
      analyser.getByteFrequencyData(dataArray);
      const barCount = 44;
      const barWidth = (canvas.width / barCount);
      let x = 0;

      for (let i = 0; i < barCount; i++) {
        const val = dataArray[i * 2] || 0;
        const barHeight = (val / 255) * (canvas.height * 0.82);

        const grad = ctx.createLinearGradient(0, canvas.height, 0, canvas.height - barHeight);
        grad.addColorStop(0, '#22d3ee');
        grad.addColorStop(0.6, '#a78bfa');
        grad.addColorStop(1, '#a3e635');

        ctx.fillStyle = grad;
        ctx.fillRect(x, canvas.height - barHeight, barWidth - 2.5, barHeight);
        x += barWidth;
      }
    } else if (style === 'wave') {
      analyser.getByteTimeDomainData(dataArray);
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#22d3ee';
      ctx.shadowColor = 'rgba(34,211,238,0.4)';
      ctx.shadowBlur = 8;
      ctx.beginPath();

      const sliceWidth = canvas.width / bufferLength;
      let x = 0;

      for (let i = 0; i < bufferLength; i++) {
        const v = dataArray[i] / 128.0;
        const y = (v * canvas.height) / 2;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
        x += sliceWidth;
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
    } else if (style === 'circle') {
      analyser.getByteFrequencyData(dataArray);
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;
      const baseRadius = Math.min(cx, cy) * 0.42;
      const points = 56;

      ctx.beginPath();
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const val = dataArray[i] || 0;
        const r = baseRadius + (val / 255) * 50;
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.strokeStyle = '#a78bfa';
      ctx.lineWidth = 3;
      ctx.shadowColor = 'rgba(167,139,250,0.4)';
      ctx.shadowBlur = 10;
      ctx.stroke();
      ctx.shadowBlur = 0;
    }
  }

  if (btn) {
    btn.addEventListener('click', () => {
      if (!isRunning) {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          audioCtx = new AudioContextClass();
          analyser = audioCtx.createAnalyser();
          analyser.fftSize = 256;
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        resizeCanvas();
        isRunning = true;
        playIco?.classList.add('hidden');
        stopIco?.classList.remove('hidden');
        if (statusTxt) statusTxt.textContent = 'Dừng Audio';
        overlay?.classList.add('hidden');
        synthInterval = setInterval(triggerSynthBeat, 240);
        draw();
      } else {
        isRunning = false;
        clearInterval(synthInterval);
        cancelAnimationFrame(animId);
        playIco?.classList.remove('hidden');
        stopIco?.classList.add('hidden');
        if (statusTxt) statusTxt.textContent = 'Kích hoạt Audio';
        overlay?.classList.remove('hidden');
        if (ctx && canvas) ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    });
  }
</script>
