---
interface Props {
  text: string;
  variant?: 'cyan' | 'purple' | 'emerald' | 'default';
  size?: 'sm' | 'md';
}

const { text, variant = 'default', size = 'sm' } = Astro.props;

const variantStyles = {
  default: 'bg-[#161C2E] text-gray-300 border-[#1F263B] hover:border-gray-500',
  cyan: 'bg-cyan-950/40 text-cyan-300 border-cyan-500/30 hover:border-cyan-400',
  purple: 'bg-purple-950/40 text-purple-300 border-purple-500/30 hover:border-purple-400',
  emerald: 'bg-emerald-950/40 text-emerald-300 border-emerald-500/30 hover:border-emerald-400',
};

const sizeStyles = {
  sm: 'text-[11px] px-2.5 py-0.5',
  md: 'text-xs px-3 py-1',
};
---

<span class:list={[
  "inline-flex items-center font-mono border rounded-md transition-colors duration-150",
  variantStyles[variant],
  sizeStyles[size]
]}>
  #{text}
</span>
