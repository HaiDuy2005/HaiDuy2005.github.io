---
interface Props {
  text: string;
  variant?: 'default' | 'cyan' | 'violet' | 'lime';
  size?: 'sm' | 'md';
}
const { text, variant = 'default', size = 'sm' } = Astro.props;

const styles = {
  default: 'background:var(--bg-raised);border-color:var(--border);color:var(--text-low);',
  cyan:    'background:var(--cyan-dim);border-color:rgba(34,211,238,0.2);color:var(--cyan);',
  violet:  'background:var(--violet-dim);border-color:rgba(167,139,250,0.2);color:var(--violet);',
  lime:    'background:var(--lime-dim);border-color:rgba(163,230,53,0.2);color:var(--lime);',
};
const sizeStyles = {
  sm: 'padding:2px 8px;font-size:11px;',
  md: 'padding:3px 10px;font-size:12px;',
};
---
<span
  class="inline-flex items-center border rounded-md transition-colors"
  style={`font-family:var(--font-mono);${styles[variant]}${sizeStyles[size]}`}
>
  #{text}
</span>
