---
import Tag from './Tag.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      category: 'Web' | 'Cloud' | 'AI' | 'Other';
      tags: string[];
      thumbnail?: string;
      problem: string;
      role: string;
      githubUrl?: string;
      demoUrl?: string;
      status: 'Completed' | 'In Progress' | 'Archived';
      featured?: boolean;
    };
  };
}
const { project } = Astro.props;
const { data, id } = project;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailUrl = `${baseUrl}/projects/${id}`;

const categoryColors: Record<string, string> = {
  Web:   'var(--cyan)',
  Cloud: 'var(--violet)',
  AI:    'var(--lime)',
  Other: 'var(--text-low)',
};
const statusLabel: Record<string, { color: string; label: string }> = {
  Completed:   { color: 'var(--lime)',   label: '● Completed'  },
  'In Progress':{ color: '#f59e0b',       label: '● In Progress'},
  Archived:    { color: 'var(--text-low)', label: '● Archived'  },
};
const catGradient: Record<string, string> = {
  Web:   'from-cyan-900/20 to-transparent',
  Cloud: 'from-violet-900/20 to-transparent',
  AI:    'from-lime-900/10 to-transparent',
  Other: 'from-slate-800/30 to-transparent',
};
---

<article class="card group flex flex-col overflow-hidden h-full">

  <!-- Thumbnail -->
  <div class="relative w-full aspect-[16/9] overflow-hidden"
       style="background:var(--bg-raised);border-bottom:1px solid var(--border);">
    {data.thumbnail
      ? <img src={data.thumbnail} alt={data.title} loading="lazy"
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"/>
      : <div class={`w-full h-full flex items-center justify-center bg-gradient-to-br ${catGradient[data.category]}`}>
          <span style={`font-family:var(--font-mono);color:${categoryColors[data.category]};opacity:0.3;font-size:28px;font-weight:700;letter-spacing:0.1em;`}>
            {data.category}
          </span>
        </div>
    }

    <!-- Category badge — top-left only, clean -->
    <div class="absolute top-3 left-3">
      <span class="pill" style={`color:${categoryColors[data.category]};background:rgba(7,9,15,0.85);backdrop-filter:blur(8px);`}>
        {data.category}
      </span>
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5 gap-4">

    <!-- Title + status -->
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-base font-semibold leading-snug group-hover:text-[var(--cyan)] transition-colors"
          style="font-family:var(--font-heading);color:var(--text-high);">
        <a href={detailUrl} class="focus:outline-none">
          <span class="absolute inset-0 z-0"></span>
          {data.title}
        </a>
      </h3>
      <span class="shrink-0 text-[10.5px] font-mono pt-0.5"
            style={`color:${statusLabel[data.status].color};white-space:nowrap;`}>
        {statusLabel[data.status].label}
      </span>
    </div>

    <!-- Description -->
    <p class="text-[13px] leading-relaxed line-clamp-2" style="color:var(--text-low);">
      {data.description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      {data.tags.slice(0, 4).map(t => <Tag text={t} />)}
    </div>

    <!-- Footer: links -->
    <div class="mt-auto pt-3 flex items-center justify-between"
         style="border-top:1px solid var(--border);">
      <a href={detailUrl}
         class="text-[12px] font-mono font-medium flex items-center gap-1.5 transition-colors z-10 relative"
         style="color:var(--text-low);"
         onmouseover="this.style.color='var(--cyan)'" onmouseout="this.style.color='var(--text-low)'">
        Chi tiết <span>→</span>
      </a>
      <div class="flex items-center gap-2 z-10 relative">
        {data.githubUrl
          ? <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
               class="btn-ghost" style="padding:4px 10px;font-size:11px;">GitHub↗</a>
          : <span style="font-family:var(--font-mono);font-size:10.5px;color:var(--text-low);">Private</span>
        }
        {data.demoUrl
          ? <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" aria-label="Demo"
               class="btn-primary" style="padding:4px 12px;font-size:11px;">Demo↗</a>
          : <span style="font-family:var(--font-mono);font-size:10.5px;color:var(--text-low);">Soon</span>
        }
      </div>
    </div>
  </div>
</article>
