---
import { siteConfig } from '../data/siteConfig';

const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

function href(path: string) {
  return path === '/' ? `${baseUrl}/` || '/' : `${baseUrl}${path}`;
}
function isActive(path: string) {
  const target = href(path);
  if (path === '/') return currentPath === target || currentPath === '/' || currentPath === `${baseUrl}/`;
  return currentPath.startsWith(target);
}
---

<header id="site-header"
  class="sticky top-0 z-50 w-full transition-all duration-300"
  style="background: rgba(7,9,15,0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.06);">

  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-[60px]">

      <!-- Logo -->
      <a href={href('/')} class="flex items-center gap-2.5 group focus:outline-none">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-all duration-200 group-hover:shadow-[0_0_16px_rgba(34,211,238,0.4)]"
             style="background: var(--bg-card); border: 1px solid rgba(34,211,238,0.25);">
          <span style="font-family:var(--font-mono); color:var(--cyan); font-weight:700; font-size:15px;">D</span>
        </div>
        <div class="leading-none">
          <span style="font-family:var(--font-heading); font-weight:800; font-size:15px; letter-spacing:-0.01em; color:var(--text-high);">
            DUY<span style="color:var(--violet);">VERSE</span>
          </span>
          <span class="hidden sm:block" style="font-family:var(--font-mono); font-size:9.5px; color:var(--text-low); letter-spacing:0.08em;">
            CODE · CREATE · FLOW
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {siteConfig.navigation.map(item => {
          const active = isActive(item.href);
          return (
            <a href={href(item.href)}
               class="relative px-3 py-1.5 rounded-md transition-colors duration-150"
               style={active
                 ? 'font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;color:var(--cyan);background:var(--cyan-dim);'
                 : 'font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;color:var(--text-low);'
               }
               data-active={active}
            >
              {item.name}
              {active && <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-3 h-px rounded-full" style="background:var(--cyan);"></span>}
            </a>
          );
        })}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <!-- Status pill — desktop only -->
        <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full"
             style="background:var(--bg-raised);border:1px solid var(--border);font-family:var(--font-mono);font-size:10.5px;color:var(--text-low);">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--lime);"></span>
          <span>Intern-ready</span>
        </div>

        <!-- CTA -->
        <a href={href('/contact')} class="btn-primary hidden sm:inline-flex" style="padding:7px 16px;font-size:12px;">
          Connect
        </a>

        <!-- Hamburger -->
        <button id="menu-btn" type="button" aria-label="Menu" aria-expanded="false"
                class="flex md:hidden p-2 rounded-lg transition-colors"
                style="background:var(--bg-raised);border:1px solid var(--border);">
          <svg id="icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" class="hidden md:hidden border-t" style="background:rgba(7,9,15,0.97);border-color:var(--border);">
    <div class="max-w-6xl mx-auto px-5 py-4 space-y-1">
      {siteConfig.navigation.map(item => {
        const active = isActive(item.href);
        return (
          <a href={href(item.href)}
             class="flex items-center justify-between px-3 py-2.5 rounded-lg"
             style={active
               ? 'font-family:var(--font-mono);font-size:13px;color:var(--cyan);background:var(--cyan-dim);'
               : 'font-family:var(--font-mono);font-size:13px;color:var(--text-mid);'
             }
          >
            <span>{item.name}</span>
            {active && <span style="font-size:10px;color:var(--cyan);">●</span>}
          </a>
        );
      })}
      <div class="pt-3">
        <a href={href('/contact')} class="btn-primary w-full justify-center" style="font-size:13px;">
          Connect
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn   = document.getElementById('menu-btn');
  const nav   = document.getElementById('mobile-nav');
  const open  = document.getElementById('icon-open');
  const close = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden');
    open?.classList.toggle('hidden');
    close?.classList.toggle('hidden');
  });
</script>
