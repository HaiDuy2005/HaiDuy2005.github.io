---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../data/siteConfig';
const { author } = siteConfig;
---

<BaseLayout
  title="Connect — DUYVERSE"
  description="Liên hệ trao đổi cơ hội thực tập, dự án công nghệ hoặc giao lưu âm nhạc với Hải Duy."
>

  <div class="max-w-3xl mx-auto space-y-14 py-4">

    <!-- Header -->
    <div class="space-y-2 animate-fade-in-up">
      <p class="section-label">// Transmission Protocol</p>
      <h1 style="font-family:var(--font-heading);font-size:clamp(1.6rem,4vw,2.2rem);font-weight:900;color:var(--text-high);">
        Kết Nối & Trao Đổi
      </h1>
      <p style="font-size:14px;color:var(--text-low);max-width:56ch;line-height:1.7;">
        Cởi mở với cơ hội thực tập phần mềm, cộng tác dự án Web & AI, hoặc trò chuyện về công nghệ và âm nhạc.
      </p>
    </div>

    <!-- Public channels — compact 3-col -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

      <a href={author.github} target="_blank" rel="noopener noreferrer"
         class="card card-interactive p-5 space-y-2 group reveal delay-1" style="text-decoration:none;display:block;">
        <div class="flex items-center justify-between">
          <span class="section-label" style="color:var(--cyan);">GitHub</span>
          <span style="color:var(--text-low);font-size:14px;" class="group-hover:translate-x-1 group-hover:text-[var(--cyan)] transition-all">↗</span>
        </div>
        <p style="font-size:13px;color:var(--text-high);font-weight:600;">Code Repositories</p>
        <p style="font-size:12px;color:var(--text-low);">Mã nguồn dự án và đóng góp mã nguồn mở.</p>
      </a>

      <a href={author.linkedin} target="_blank" rel="noopener noreferrer"
         class="card card-interactive p-5 space-y-2 group reveal delay-2" style="text-decoration:none;display:block;">
        <div class="flex items-center justify-between">
          <span class="section-label" style="color:var(--violet);">LinkedIn</span>
          <span style="color:var(--text-low);font-size:14px;" class="group-hover:translate-x-1 group-hover:text-[var(--violet)] transition-all">↗</span>
        </div>
        <p style="font-size:13px;color:var(--text-high);font-weight:600;">Professional Network</p>
        <p style="font-size:12px;color:var(--text-low);">Kết nối hồ sơ nghề nghiệp và hoạt động chuyên môn.</p>
      </a>

      <div class="card card-interactive p-5 space-y-2 reveal delay-3">
        <div class="flex items-center justify-between">
          <span class="section-label" style="color:var(--lime);">Status</span>
          <span class="w-2 h-2 rounded-full animate-pulse" style="background:var(--lime);"></span>
        </div>
        <p style="font-size:13px;color:var(--text-high);font-weight:600;">{author.location}</p>
        <p style="font-size:12px;color:var(--lime);">{author.status}</p>
      </div>

    </div>

    <!-- Contact form / email section -->
    <div class="reveal delay-2">
      <ContactForm />
    </div>

    <!-- Config hint -->
    <div class="p-4 rounded-lg reveal delay-3" style="background:var(--bg-raised);border:1px solid var(--border);font-family:var(--font-mono);font-size:12px;color:var(--text-low);">
      <span style="color:var(--cyan);font-weight:600;">// Config:</span>
      Cập nhật Email, GitHub, LinkedIn tại <code style="color:var(--cyan);">src/data/siteConfig.ts</code>.
    </div>

  </div>
</BaseLayout>
