---
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="404 — Not Found">
  <div class="flex flex-col items-center justify-center py-24 text-center space-y-6 max-w-md mx-auto">
    <p class="section-label">// Signal Lost</p>
    <h1 style="font-family:var(--font-heading);font-size:6rem;font-weight:900;line-height:1;letter-spacing:-0.04em;"
        class="gradient-text">404</h1>
    <h2 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:700;color:var(--text-high);">
      Không tìm thấy trang này
    </h2>
    <p style="font-size:14px;color:var(--text-low);line-height:1.7;">
      URL bạn truy cập không tồn tại trong hệ thống DUYVERSE hoặc đã được di chuyển.
    </p>
    <a href={`${baseUrl}/` || '/'} class="btn-primary">← Về trang chủ</a>
  </div>
</BaseLayout>
