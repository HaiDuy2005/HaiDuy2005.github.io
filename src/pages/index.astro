---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import MusicMood from '../components/MusicMood.astro';
import { siteConfig } from '../data/siteConfig';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
function formatHref(href: string) {
  if (href === '/') return `${baseUrl}/` || '/';
  return `${baseUrl}${href}`;
}

// Fetch featured projects
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Fetch latest posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  
  <!-- HERO SECTION -->
  <section class="relative pt-6 sm:pt-14 pb-16 sm:pb-24 overflow-hidden">
    
    <div class="space-y-6 max-w-4xl">
      
      <!-- Top Cyber Tag / Terminal Header -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#111522] border border-cyan-500/30 text-xs font-mono text-cyan-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-widest">SYSTEM: ONLINE</span>
        <span class="text-gray-600">|</span>
        <span class="text-gray-400">VERSION: 2026.1</span>
      </div>

      <!-- Main Headline with Gradient Glow -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black tracking-tight text-white leading-none">
        DUY<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-emerald-400">VERSE</span>
      </h1>

      <p class="text-xl sm:text-2xl font-mono text-cyan-300 font-medium">
        Code. Create. Flow.
      </p>

      <p class="text-base sm:text-lg text-gray-300 font-sans max-w-2xl leading-relaxed">
        {siteConfig.author.bio}
      </p>

      <!-- Dynamic Typing / Roles Pill -->
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-gray-400">
        <span class="text-purple-400">$</span>
        <span>role:</span>
        <span class="text-white border-b-2 border-cyan-400 pb-0.5" id="hero-typing-role">
          IT Student • Developer • AI Explorer
        </span>
      </div>

      <!-- Action Buttons Row -->
      <div class="pt-4 flex flex-wrap items-center gap-3 sm:gap-4">
        <a 
          href={formatHref('/projects')}
          class="px-6 py-3 rounded-lg bg-gradient-to-r from-cyan-400 to-cyan-300 hover:from-cyan-300 hover:to-white text-[#080A12] font-mono font-bold text-xs sm:text-sm tracking-wider uppercase transition-all shadow-[0_0_20px_rgba(0,229,255,0.3)] hover:shadow-[0_0_30px_rgba(0,229,255,0.6)] cursor-pointer"
        >
          Explore Projects
        </a>

        <a 
          href={formatHref('/posts')}
          class="px-6 py-3 rounded-lg bg-[#111522] hover:bg-[#161C2E] border border-purple-500/40 text-purple-300 hover:text-white font-mono font-semibold text-xs sm:text-sm tracking-wider uppercase transition-all shadow-[0_0_15px_rgba(139,92,246,0.15)]"
        >
          Read Posts
        </a>

        <a 
          href={formatHref('/contact')}
          class="px-6 py-3 rounded-lg bg-[#111522] hover:bg-[#161C2E] border border-[#1F263B] text-gray-300 hover:text-white font-mono text-xs sm:text-sm tracking-wider uppercase transition-all"
        >
          Contact Me
        </a>
      </div>

    </div>

    <!-- Music Mood Widget Preview -->
    <div class="mt-12 max-w-3xl">
      <MusicMood />
    </div>

  </section>

  <!-- QUICK ABOUT / HIGHLIGHT STATS SECTION -->
  <section class="py-12 border-t border-[#1F263B]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-xl bg-[#111522]/80 border border-[#1F263B]">
        <div class="font-mono text-xs text-cyan-400 uppercase tracking-widest mb-2">// SPECIALIZATION</div>
        <h3 class="text-xl font-heading font-bold text-white mb-2">Web Development</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Xây dựng web tĩnh hiệu năng cao với Astro, phát triển backend API chuẩn mực với ASP.NET Core và giao diện tương tác TypeScript.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-[#111522]/80 border border-[#1F263B]">
        <div class="font-mono text-xs text-purple-400 uppercase tracking-widest mb-2">// EXPLORATION</div>
        <h3 class="text-xl font-heading font-bold text-white mb-2">Cloud & AI Workflows</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Tìm hiểu kiến trúc Cloud, tự động hóa quy trình với GitHub Actions CI/CD và ứng dụng LLM trong học tập và sản xuất nội dung.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-[#111522]/80 border border-[#1F263B]">
        <div class="font-mono text-xs text-emerald-400 uppercase tracking-widest mb-2">// PASSION & RHYTHM</div>
        <h3 class="text-xl font-heading font-bold text-white mb-2">Hip-hop & Flow</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Cảm hứng sáng tạo từ âm nhạc Hip-hop, beatmaking và tư duy nhịp điệu giúp các dòng code luôn giữ được sự mạch lạc và rõ ràng.
        </p>
      </div>

    </div>
  </section>

  <!-- FEATURED PROJECTS SECTION -->
  <section class="py-12 border-t border-[#1F263B]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">
          <span>// PORTFOLIO SHOWCASE</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-black text-white">
          Dự Án Nổi Bật
        </h2>
      </div>

      <a 
        href={formatHref('/projects')}
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 font-bold flex items-center gap-1.5"
      >
        <span>XEM TẤT CẢ DỰ ÁN</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- LATEST POSTS SECTION -->
  <section class="py-12 border-t border-[#1F263B]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-purple-400 uppercase tracking-widest mb-2">
          <span>// TRANSMISSIONS & NOTES</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-black text-white">
          Bài Viết Mới Nhất
        </h2>
      </div>

      <a 
        href={formatHref('/posts')}
        class="text-xs font-mono text-purple-400 hover:text-purple-300 font-bold flex items-center gap-1.5"
      >
        <span>TẤT CẢ BÀI ĐĂNG (MARKDOWN)</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <!-- TECH STACK OVERVIEW SECTION -->
  <section class="py-12 border-t border-[#1F263B]">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-400 uppercase tracking-widest mb-2">
        <span>// VERIFIED CAPABILITIES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-heading font-black text-white">
        Tech Stack Thực Tế
      </h2>
      <p class="text-sm text-gray-400 mt-1">
        Các công nghệ và công cụ đã thực sự được áp dụng trong quá trình học tập và hoàn thiện sản phẩm.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {siteConfig.skills.slice(0, 4).map((group) => (
        <div class="p-5 rounded-xl bg-[#111522]/80 border border-[#1F263B]">
          <h4 class="font-mono text-xs font-bold text-cyan-300 uppercase tracking-wider mb-3">
            {group.category}
          </h4>
          <ul class="space-y-2">
            {group.items.map((item) => (
              <li class="flex items-center gap-2 text-xs text-gray-300 font-mono">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
