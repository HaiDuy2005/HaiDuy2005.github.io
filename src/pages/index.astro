---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import MusicMood from '../components/MusicMood.astro';
import { siteConfig } from '../data/siteConfig';
import { getCollection } from 'astro:content';

const h = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  return path === '/' ? `${base}/` || '/' : `${base}${path}`;
};

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout>

  <!-- ═══════════════════════════════════════
       HERO SECTION (Smooth Entrance & Motion)
  ════════════════════════════════════════ -->
  <section class="pt-8 pb-20 sm:pt-16 sm:pb-28">
    <div class="max-w-2xl space-y-7 animate-fade-in-up">

      <!-- Status indicator with floating animation -->
      <div class="pill pill-lime inline-flex animate-float" style="font-size:11px;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--lime);display:inline-block;"></span>
        Available for internship · 2026
      </div>

      <!-- Headline -->
      <div class="space-y-3">
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.6rem,7vw,4.5rem);font-weight:900;letter-spacing:-0.035em;line-height:1;color:var(--text-high);">
          DUY<span class="gradient-text">VERSE</span>
        </h1>
        <p style="font-family:var(--font-mono);font-size:clamp(1rem,2.5vw,1.25rem);color:var(--cyan);font-weight:500;letter-spacing:0.01em;">
          Code. Create. Flow.
        </p>
      </div>

      <!-- Bio -->
      <p style="font-size:clamp(0.95rem,2vw,1.05rem);color:var(--text-mid);line-height:1.75;max-width:52ch;">
        Sinh viên IT đam mê <strong style="color:var(--text-high);font-weight:500;">Web Development</strong>,
        khám phá <strong style="color:var(--text-high);font-weight:500;">Cloud & AI</strong> và
        tìm cảm hứng từ nhịp điệu
        <strong style="color:var(--text-high);font-weight:500;">Hip-hop</strong>.
      </p>

      <!-- Dynamic Typing / Animated Role line -->
      <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-low);display:flex;align-items:center;gap:8px;">
        <span style="color:var(--violet);">$</span>
        <span>role =</span>
        <span id="typewriter-role" style="color:var(--text-high);border-bottom:1px solid var(--cyan);padding-bottom:1px;min-height:20px;">
          "IT Student · Developer"
        </span>
        <span class="animate-blink" style="color:var(--cyan);font-weight:700;">|</span>
      </div>

      <!-- Action buttons with shimmer & hover lift -->
      <div class="flex flex-wrap gap-3 pt-2">
        <a href={h('/projects')} class="btn-primary btn-shimmer">
          Explore Projects
        </a>
        <a href={h('/posts')} class="btn-ghost hover:scale-105 active:scale-95 transition-all">
          Read Posts
        </a>
        <a href={h('/contact')} class="btn-ghost hover:scale-105 active:scale-95 transition-all">
          Contact Me
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       QUICK BIO CARDS (Scroll Reveal)
  ════════════════════════════════════════ -->
  <section class="pb-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

      <div class="card card-interactive p-5 space-y-2 reveal delay-1">
        <div class="section-label" style="color:var(--cyan);">Web Development</div>
        <p style="font-size:13px;color:var(--text-low);line-height:1.65;">
          Astro, ASP.NET Core, TypeScript — xây dựng web nhanh, chuẩn mực và dễ bảo trì.
        </p>
      </div>

      <div class="card card-interactive p-5 space-y-2 reveal delay-2">
        <div class="section-label" style="color:var(--violet);">Cloud & AI</div>
        <p style="font-size:13px;color:var(--text-low);line-height:1.65;">
          GitHub Actions CI/CD, Docker cơ bản, LLM prompt engineering và RAG pipeline.
        </p>
      </div>

      <div class="card card-interactive p-5 space-y-2 reveal delay-3">
        <div class="section-label" style="color:var(--lime);">Hip-hop & Flow</div>
        <p style="font-size:13px;color:var(--text-low);line-height:1.65;">
          Beatmaking, sáng tác Rap — nhịp điệu âm nhạc làm nguồn cảm hứng tư duy logic.
        </p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════
       FEATURED PROJECTS (Scroll Reveal Stagger)
  ════════════════════════════════════════ -->
  <section class="pb-20">
    <div class="flex items-end justify-between mb-7 reveal">
      <div>
        <p class="section-label mb-1.5">Featured Projects</p>
        <h2 style="font-family:var(--font-heading);font-size:clamp(1.4rem,3vw,1.75rem);font-weight:800;color:var(--text-high);">
          Dự Án Nổi Bật
        </h2>
      </div>
      <a href={h('/projects')} class="btn-ghost" style="padding:6px 14px;font-size:12px;">
        Tất cả →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredProjects.map((project, idx) => (
        <div class={`reveal delay-${idx + 1} h-full`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       LATEST POSTS (Scroll Reveal Stagger)
  ════════════════════════════════════════ -->
  <section class="pb-20">
    <div class="flex items-end justify-between mb-7 reveal">
      <div>
        <p class="section-label mb-1.5" style="color:var(--violet);">Latest Posts</p>
        <h2 style="font-family:var(--font-heading);font-size:clamp(1.4rem,3vw,1.75rem);font-weight:800;color:var(--text-high);">
          Bài Viết Mới Nhất
        </h2>
      </div>
      <a href={h('/posts')} class="btn-ghost" style="padding:6px 14px;font-size:12px;">
        Tất cả →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {latestPosts.map((post, idx) => (
        <div class={`reveal delay-${idx + 1} h-full`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       MUSIC MOOD + TECH STACK (2-col)
  ════════════════════════════════════════ -->
  <section class="pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Music Mood Widget -->
      <div class="lg:col-span-5 reveal delay-1">
        <p class="section-label mb-3" style="color:var(--lime);">Audio Mood</p>
        <MusicMood />
      </div>

      <!-- Tech Stack -->
      <div class="lg:col-span-7 reveal delay-2">
        <p class="section-label mb-3" style="color:var(--cyan);">Tech Stack</p>
        <div class="card card-interactive p-6">
          <div class="grid grid-cols-2 sm:grid-cols-2 gap-x-10 gap-y-6">
            {siteConfig.skills.slice(0, 4).map((group, gIdx) => (
              <div class="space-y-2">
                <p style="font-family:var(--font-mono);font-size:11px;font-weight:600;color:var(--cyan);letter-spacing:0.08em;text-transform:uppercase;">
                  {group.category}
                </p>
                <ul class="space-y-1.5">
                  {group.items.map((item, iIdx) => (
                    <li style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);display:flex;align-items:center;gap:7px;">
                      <span style="width:5px;height:5px;border-radius:50%;background:var(--border-hi);display:inline-block;flex-shrink:0;"></span>
                      {item.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  // Smooth Interactive Typewriter Effect for Hero
  const roles = [
    '"IT Student · Frontend Developer"',
    '"Cloud & DevOps Explorer"',
    '"AI Prompt & Workflow Builder"',
    '"Hip-hop Beatmaker & Digital Flow"'
  ];
  let roleIdx = 0;
  let charIdx = 0;
  let isDeleting = false;
  const target = document.getElementById('typewriter-role');

  function typeEffect() {
    if (!target) return;
    const currentText = roles[roleIdx];

    if (!isDeleting) {
      target.textContent = currentText.substring(0, charIdx + 1);
      charIdx++;
      if (charIdx === currentText.length) {
        isDeleting = true;
        setTimeout(typeEffect, 2200); // pause at end of sentence
        return;
      }
    } else {
      target.textContent = currentText.substring(0, charIdx - 1);
      charIdx--;
      if (charIdx === 0) {
        isDeleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        setTimeout(typeEffect, 400); // pause before next word
        return;
      }
    }

    const speed = isDeleting ? 30 : 65;
    setTimeout(typeEffect, speed);
  }

  typeEffect();
</script>
