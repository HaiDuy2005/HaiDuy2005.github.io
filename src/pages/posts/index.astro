---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = ['All', ...new Set(sorted.map(p => p.data.category))];
const tags = [...new Set(sorted.flatMap(p => p.data.tags))];
---

<BaseLayout
  title="Bài Viết & Ghi Chú — DUYVERSE"
  description="Blog Markdown cá nhân: Web, Cloud, AI và văn hóa Hip-hop."
>

  <div class="space-y-10 py-4">

    <!-- Header -->
    <div class="space-y-2">
      <p class="section-label" style="color:var(--violet);">// Markdown Logs</p>
      <h1 style="font-family:var(--font-heading);font-size:clamp(1.6rem,4vw,2.2rem);font-weight:900;color:var(--text-high);">
        Bài Viết & Ghi Chú
      </h1>
      <p style="font-size:14px;color:var(--text-low);max-width:56ch;line-height:1.7;">
        Tất cả bài viết được quản lý bằng Markdown thuần túy. Chia sẻ kiến thức về lập trình, Cloud, AI và Hip-hop.
      </p>
    </div>

    <!-- Filter bar -->
    <div class="card p-4 space-y-3">
      <div class="flex flex-col sm:flex-row gap-3">
        <!-- Search -->
        <div class="relative flex-1 max-w-sm">
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
               style="color:var(--text-low);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input id="post-search" type="text"
                 placeholder="Tìm bài viết..."
                 style="width:100%;padding:8px 12px 8px 36px;border-radius:8px;background:var(--bg-base);border:1px solid var(--border);color:var(--text-high);font-family:var(--font-mono);font-size:13px;outline:none;"
                 onfocus="this.style.borderColor='var(--violet)'" onblur="this.style.borderColor='var(--border)'"/>
        </div>

        <!-- Category -->
        <div class="flex items-center gap-1.5 flex-wrap" id="post-cats">
          {categories.map((cat, i) => (
            <button type="button" data-cat={cat} class="post-cat-btn"
                    style={i === 0
                      ? 'padding:6px 14px;border-radius:7px;font-family:var(--font-mono);font-size:12px;font-weight:600;cursor:pointer;background:var(--violet);color:#fff;border:none;'
                      : 'padding:6px 14px;border-radius:7px;font-family:var(--font-mono);font-size:12px;cursor:pointer;background:transparent;color:var(--text-low);border:1px solid var(--border);'
                    }>
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Tags -->
      <div class="flex items-center gap-2 flex-wrap" style="padding-top:10px;border-top:1px solid var(--border);">
        <span style="font-family:var(--font-mono);font-size:10.5px;color:var(--text-low);">Tags:</span>
        {tags.map(tag => (
          <button type="button" data-tag={tag} class="tag-btn"
                  style="font-family:var(--font-mono);font-size:11px;padding:2px 8px;border-radius:5px;background:transparent;border:1px solid var(--border);color:var(--text-low);cursor:pointer;transition:color .15s,border-color .15s;">
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Posts grid -->
    <div id="posts-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sorted.map(post => (
        <div class="post-item h-full"
             data-cat={post.data.category}
             data-tags={post.data.tags.join(',')}
             data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
          <div class="h-full"><PostCard post={post} /></div>
        </div>
      ))}
    </div>

    <!-- Empty -->
    <div id="posts-empty" class="hidden py-20 text-center rounded-xl"
         style="background:var(--bg-raised);border:1px solid var(--border);">
      <p style="font-family:var(--font-mono);font-size:13px;color:var(--text-low);">
        Không tìm thấy bài viết nào.
      </p>
    </div>

  </div>
</BaseLayout>

<script>
  const search  = document.getElementById('post-search') as HTMLInputElement;
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.post-cat-btn');
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const items   = document.querySelectorAll<HTMLElement>('.post-item');
  const empty   = document.getElementById('posts-empty');
  let cat = 'All', tag = '', q = '';

  function filter() {
    let count = 0;
    items.forEach(el => {
      const mc = cat === 'All' || el.dataset.cat?.toLowerCase() === cat.toLowerCase();
      const mt = !tag || (el.dataset.tags || '').split(',').includes(tag);
      const mq = !q || (el.dataset.search || '').includes(q);
      if (mc && mt && mq) { el.classList.remove('hidden'); count++; }
      else                 { el.classList.add('hidden'); }
    });
    empty?.classList.toggle('hidden', count > 0);
  }

  search?.addEventListener('input', e => { q = (e.target as HTMLInputElement).value.trim().toLowerCase(); filter(); });

  catBtns.forEach(btn => btn.addEventListener('click', () => {
    cat = btn.dataset.cat || 'All';
    catBtns.forEach(b => Object.assign(b.style, { background: 'transparent', color: 'var(--text-low)', border: '1px solid var(--border)', fontWeight: 'normal' }));
    Object.assign(btn.style, { background: 'var(--violet)', color: '#fff', border: 'none', fontWeight: '600' });
    filter();
  }));

  tagBtns.forEach(btn => btn.addEventListener('click', () => {
    const t = btn.dataset.tag || '';
    if (tag === t) {
      tag = '';
      btn.style.color = 'var(--text-low)';
      btn.style.borderColor = 'var(--border)';
    } else {
      tagBtns.forEach(b => { b.style.color = 'var(--text-low)'; b.style.borderColor = 'var(--border)'; });
      tag = t;
      btn.style.color = 'var(--cyan)';
      btn.style.borderColor = 'rgba(34,211,238,0.4)';
    }
    filter();
  }));
</script>
