---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';
const { author, skills } = siteConfig;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="About Hải Duy — IT Student & Developer"
  description="Câu chuyện hành trình học tập IT, kỹ năng lập trình, định hướng Cloud & AI và niềm đam mê Hip-hop của Hải Duy."
>

  <div class="max-w-3xl mx-auto space-y-16 py-4">

    <!-- ─── Bio header ─── -->
    <section class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-center">

      <!-- Avatar -->
      <div class="sm:col-span-4 flex justify-center sm:justify-start">
        <div class="relative w-44 h-44 rounded-2xl overflow-hidden"
             style="border:1px solid var(--border-mid);box-shadow:0 0 40px rgba(34,211,238,0.1);">
          <img src={author.avatar} alt={author.name} class="w-full h-full object-cover"/>
          <div class="absolute bottom-0 inset-x-0 h-1"
               style="background:linear-gradient(to right,var(--cyan),var(--violet));"></div>
        </div>
      </div>

      <!-- Bio text -->
      <div class="sm:col-span-8 space-y-4">
        <div>
          <p class="section-label mb-1.5">// Personal Profile</p>
          <h1 style="font-family:var(--font-heading);font-size:2rem;font-weight:900;color:var(--text-high);">
            {author.name}
          </h1>
          <p style="font-family:var(--font-mono);font-size:13px;color:var(--cyan);margin-top:4px;">
            {author.role}
          </p>
        </div>

        <p style="font-size:14px;color:var(--text-mid);line-height:1.8;max-width:50ch;">
          {author.bio}
        </p>

        <!-- Status & CV -->
        <div class="flex flex-wrap gap-3 pt-1">
          <div class="pill" style="color:var(--lime);border-color:rgba(163,230,53,0.2);background:var(--lime-dim);">
            <span style="width:6px;height:6px;border-radius:50%;background:var(--lime);display:inline-block;"></span>
            {author.status}
          </div>
          {author.cvUrl
            ? <a href={author.cvUrl} target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding:7px 18px;font-size:12px;">
                Tải CV PDF
              </a>
            : <span class="pill">CV đang cập nhật — liên hệ qua Email</span>
          }
        </div>
      </div>
    </section>

    <!-- ─── 3 Specializations ─── -->
    <section class="space-y-5">
      <div>
        <p class="section-label mb-1">// Roadmap & Vision</p>
        <h2 style="font-family:var(--font-heading);font-size:1.4rem;font-weight:800;color:var(--text-high);">
          Định Hướng Chuyên Môn
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { n: '01', label: 'Web Development',  color: 'var(--cyan)',   body: 'Xây dựng ứng dụng web theo Clean Architecture, ưu tiên tốc độ tải, accessibility và UX mượt mà.' },
          { n: '02', label: 'Cloud & DevOps',   color: 'var(--violet)', body: 'CI/CD với GitHub Actions, Docker, kiến trúc microservices và hạ tầng đám mây.' },
          { n: '03', label: 'AI Integration',   color: 'var(--lime)',   body: 'Nhúng LLM, RAG pipeline vào phần mềm thực tế để tăng năng suất và giải quyết bài toán người dùng.' },
        ].map(spec => (
          <div class="card p-5 space-y-2">
            <div class="flex items-baseline gap-2">
              <span style={`font-family:var(--font-mono);font-size:11px;color:${spec.color};font-weight:600;`}>{spec.n}</span>
              <h3 style={`font-family:var(--font-heading);font-size:14px;font-weight:700;color:${spec.color};`}>{spec.label}</h3>
            </div>
            <p style="font-size:13px;color:var(--text-low);line-height:1.65;">{spec.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Skills grid ─── -->
    <section class="space-y-5">
      <div>
        <p class="section-label mb-1">// Verified Skills</p>
        <h2 style="font-family:var(--font-heading);font-size:1.4rem;font-weight:800;color:var(--text-high);">
          Kỹ Năng Theo Nhóm
        </h2>
        <p style="font-size:12px;color:var(--text-low);margin-top:4px;font-family:var(--font-mono);">
          * Kỹ năng thực tế đã kiểm chứng qua bài tập và đồ án học tập.
        </p>
      </div>

      <div class="card p-6">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-10 gap-y-8">
          {skills.map(group => (
            <div class="space-y-2.5">
              <p style="font-family:var(--font-mono);font-size:10.5px;font-weight:600;color:var(--cyan);letter-spacing:0.1em;text-transform:uppercase;padding-bottom:6px;border-bottom:1px solid var(--border);">
                {group.category}
              </p>
              <ul class="space-y-1.5">
                {group.items.map(item => (
                  <li style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);display:flex;align-items:center;gap:8px;">
                    <span style="width:5px;height:5px;border-radius:50%;background:var(--border-hi);flex-shrink:0;display:inline-block;"></span>
                    {item.name}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Timeline ─── -->
    <section class="space-y-5">
      <div>
        <p class="section-label mb-1">// Chronology</p>
        <h2 style="font-family:var(--font-heading);font-size:1.4rem;font-weight:800;color:var(--text-high);">
          Cột Mốc Phát Triển
        </h2>
      </div>

      <div style="padding-left:20px;border-left:1px solid var(--border);" class="space-y-8">
        {[
          { year:'2026 — Nay', color:'var(--cyan)',   title:'Portfolio Duyverse & AI Experiments', body:'Phát triển không gian số tĩnh với Astro, nghiên cứu LLM workflows và chuẩn bị ứng tuyển thực tập.' },
          { year:'2025',       color:'var(--violet)', title:'Đồ án Web & Hệ thống Quản lý',        body:'Xây dựng hệ thống quản lý CLB với ASP.NET Core, website sự kiện khoa CNTT.' },
          { year:'2023 - 2024',color:'var(--text-low)',title:'Nền tảng CS & Lập trình',            body:'Cấu trúc dữ liệu, OOP, cơ sở dữ liệu quan hệ, nguyên lý mạng máy tính.' },
        ].map(evt => (
          <div class="relative" style="padding-left:16px;">
            <div style={`position:absolute;left:-24px;top:4px;width:8px;height:8px;border-radius:50%;background:${evt.color};box-shadow:0 0 8px ${evt.color};`}></div>
            <p style={`font-family:var(--font-mono);font-size:11px;color:${evt.color};margin-bottom:4px;`}>{evt.year}</p>
            <h3 style="font-family:var(--font-heading);font-size:15px;font-weight:700;color:var(--text-high);margin-bottom:4px;">{evt.title}</h3>
            <p style="font-size:13px;color:var(--text-low);line-height:1.65;">{evt.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Music/Creative ─── -->
    <section class="card p-6 space-y-3">
      <p class="section-label" style="color:var(--violet);">// Creative DNA</p>
      <h2 style="font-family:var(--font-heading);font-size:1.2rem;font-weight:800;color:var(--text-high);">
        Âm Nhạc, Hip-hop & Sáng Tạo
      </h2>
      <p style="font-size:14px;color:var(--text-mid);line-height:1.8;max-width:60ch;">
        Văn hóa Hip-hop dạy sự kiên trì luyện tập, khả năng freestyle ứng biến khi giải quyết vấn đề kỹ thuật và tầm quan trọng của bản sắc riêng trong từng sản phẩm.
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        {['Hip-hop & Boom Bap', 'Cyberpunk Synthwave', 'Lo-Fi Beatmaking'].map(g => (
          <span class="pill pill-violet">{g}</span>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
