---
import BaseLayout from '../layouts/BaseLayout.astro';
import AudioVisualizer from '../components/AudioVisualizer.astro';
---

<BaseLayout
  title="Lab & Playground — DUYVERSE"
  description="Không gian thử nghiệm: Audio Visualizer, Matrix Canvas, và công cụ Dev nhỏ."
>

  <div class="max-w-4xl mx-auto space-y-14 py-4">

    <!-- Header -->
    <div class="space-y-2">
      <p class="section-label" style="color:var(--lime);">// Experimental R&D</p>
      <h1 style="font-family:var(--font-heading);font-size:clamp(1.6rem,4vw,2.2rem);font-weight:900;color:var(--text-high);">
        Lab & Playground
      </h1>
      <p style="font-size:14px;color:var(--text-low);max-width:52ch;line-height:1.7;">
        Các thử nghiệm chạy trực tiếp trên trình duyệt. Không cần server, không cần API key.
      </p>
    </div>

    <!-- EXP 01: Audio Visualizer -->
    <section class="space-y-3">
      <div class="flex items-center gap-3">
        <span class="pill" style="color:var(--lime);border-color:rgba(163,230,53,0.2);background:var(--lime-dim);">EXP 01</span>
        <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);">AUDIO VISUALIZER // WEB AUDIO API</span>
        <span class="pill" style="color:var(--lime);">● Interactive</span>
      </div>
      <AudioVisualizer />
    </section>

    <!-- EXP 02 & 03: side-by-side grid -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Matrix Rain -->
      <div class="card p-5 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="pill" style="color:var(--violet);border-color:rgba(167,139,250,0.2);background:var(--violet-dim);">EXP 02</span>
            <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">MATRIX RAIN</span>
          </div>
          <button id="matrix-color-btn" type="button" class="btn-ghost" style="padding:4px 10px;font-size:11px;">
            Đổi màu
          </button>
        </div>

        <p style="font-size:13px;color:var(--text-low);line-height:1.6;">
          Mưa ký tự kỹ thuật số cyberpunk — Canvas 2D + RequestAnimationFrame.
        </p>

        <div class="relative rounded-lg overflow-hidden" style="height:200px;background:var(--bg-base);border:1px solid var(--border);">
          <canvas id="matrix-canvas" class="w-full h-full block"></canvas>
        </div>
      </div>

      <!-- Slug Analyzer -->
      <div class="card p-5 space-y-4">
        <div class="flex items-center gap-2">
          <span class="pill" style="color:var(--cyan);border-color:rgba(34,211,238,0.2);background:var(--cyan-dim);">EXP 03</span>
          <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">URL SLUG TOOL</span>
        </div>

        <p style="font-size:13px;color:var(--text-low);line-height:1.6;">
          Chuyển đổi tiêu đề thành URL Slug chuẩn SEO tiếng Việt.
        </p>

        <div class="space-y-3">
          <input id="slug-in" type="text"
                 placeholder="Nhập tiêu đề bài viết..."
                 style="width:100%;padding:9px 12px;border-radius:8px;background:var(--bg-base);border:1px solid var(--border);color:var(--text-high);font-family:var(--font-mono);font-size:12px;outline:none;"
                 onfocus="this.style.borderColor='var(--cyan)'" onblur="this.style.borderColor='var(--border)'"/>

          <div class="p-3 rounded-lg" style="background:var(--bg-base);border:1px solid var(--border);">
            <p style="font-family:var(--font-mono);font-size:10px;color:var(--text-low);margin-bottom:4px;">SLUG:</p>
            <p id="slug-out" style="font-family:var(--font-mono);font-size:13px;color:var(--cyan);word-break:break-all;">
              nhap-tieu-de-de-tao-slug
            </p>
          </div>

          <div class="flex items-center justify-between" style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">
            <span>Từ: <strong id="wc" style="color:var(--text-high);">-</strong></span>
            <span>Ký tự: <strong id="cc" style="color:var(--text-high);">-</strong></span>
            <button id="copy-slug" type="button" class="btn-ghost" style="padding:4px 10px;font-size:11px;">
              Copy
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- EXP 04: Coming soon -->
    <section class="card p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
             style="border-style:dashed;">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="pill">EXP 04</span>
          <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">AI WASM BENCHMARK</span>
        </div>
        <h3 style="font-family:var(--font-heading);font-size:14px;font-weight:700;color:var(--text-high);">
          Local LLM Benchmark — WebAssembly
        </h3>
        <p style="font-size:12px;color:var(--text-low);">
          Chạy mô hình AI trực tiếp trong sandbox trình duyệt qua WASM. Đang thiết kế kiến trúc.
        </p>
      </div>
      <span class="pill" style="color:#f59e0b;border-color:rgba(245,158,11,0.2);background:rgba(245,158,11,0.08);white-space:nowrap;">
        ⏳ In Progress
      </span>
    </section>

  </div>
</BaseLayout>

<script>
  // ─── Matrix Rain ───
  const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const glyphs = '01DUYVERSE{}<>/*+=~アイウエオカキク';
    const fs = 12;
    const neonPalette = [['#22d3ee','#a78bfa','#a3e635'], ['#f472b6','#22d3ee','#fbbf24'], ['#a3e635','#34d399','#22d3ee']];
    let pi = 0, drops: number[] = [];

    function init() {
      canvas.width  = canvas.parentElement!.clientWidth;
      canvas.height = canvas.parentElement!.clientHeight;
      const cols = Math.floor(canvas.width / fs);
      drops = Array.from({ length: cols }, () => Math.floor(Math.random() * -30));
    }
    init();
    window.addEventListener('resize', init);

    document.getElementById('matrix-color-btn')?.addEventListener('click', () => {
      pi = (pi + 1) % neonPalette.length;
    });

    setInterval(() => {
      ctx.fillStyle = 'rgba(7,9,15,0.14)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const colors = neonPalette[pi];
      ctx.font = `${fs}px monospace`;
      for (let i = 0; i < drops.length; i++) {
        ctx.fillStyle = colors[i % colors.length];
        ctx.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], i * fs, drops[i] * fs);
        if (drops[i] * fs > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }, 42);
  }

  // ─── Slug Tool ───
  const slugIn  = document.getElementById('slug-in') as HTMLInputElement;
  const slugOut = document.getElementById('slug-out');
  const wc = document.getElementById('wc');
  const cc = document.getElementById('cc');
  const copySlug = document.getElementById('copy-slug');

  function toSlug(s: string) {
    return s.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[đĐ]/g, 'd')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim().replace(/\s+/g, '-').replace(/-+/g, '-');
  }
  function update() {
    const v = slugIn?.value || '';
    const slug = toSlug(v) || 'nhap-tieu-de-de-tao-slug';
    if (slugOut) slugOut.textContent = slug;
    if (wc) wc.textContent = String(v.split(/\s+/).filter(Boolean).length || 0);
    if (cc) cc.textContent = String(v.length);
  }
  slugIn?.addEventListener('input', update);
  update();
  copySlug?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(slugOut?.textContent || '');
      copySlug.textContent = 'Copied!';
      setTimeout(() => { copySlug.textContent = 'Copy'; }, 2000);
    } catch {}
  });
</script>
