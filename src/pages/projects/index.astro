---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const categories = ['All', 'Web', 'Cloud', 'AI', 'Other'];
---

<BaseLayout 
  title="Dự Án & Sản Phẩm — DUYVERSE"
  description="Danh mục các dự án cá nhân, đồ án học tập và sản phẩm công nghệ của Hải Duy."
>

  <div class="space-y-8">
    
    <!-- Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/30 text-xs font-mono text-cyan-300">
        <span>// PORTFOLIO DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-heading font-black text-white">
        Dự Án & Sản Phẩm
      </h1>
      <p class="text-sm sm:text-base text-gray-400 max-w-2xl font-sans">
        Tổng hợp các đồ án thực tế, hệ thống web và sản phẩm công nghệ đã thực hiện. Mỗi dự án đều tập trung vào việc giải quyết một bài toán cụ thể và tối ưu trải nghiệm người dùng.
      </p>
    </div>

    <!-- Search & Filter Controls Bar -->
    <div class="p-4 rounded-xl bg-[#111522]/90 border border-[#1F263B] backdrop-blur-md flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      
      <!-- Instant Search Input -->
      <div class="relative flex-1 max-w-md">
        <svg class="w-4 h-4 text-gray-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="project-search-input"
          placeholder="Tìm theo tên dự án hoặc công nghệ (e.g. Astro, C#, AI)..."
          class="w-full pl-10 pr-4 py-2 rounded-lg bg-[#0C101A] border border-[#1F263B] text-white text-xs sm:text-sm font-mono focus:outline-none focus:border-cyan-400 placeholder:text-gray-500"
        />
      </div>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0" id="category-filter-container">
        {categories.map((cat, i) => (
          <button
            type="button"
            data-category={cat}
            class:list={[
              "px-3 py-1.5 rounded-lg text-xs font-mono tracking-wider transition-colors cursor-pointer shrink-0 category-filter-btn",
              i === 0 
                ? "bg-cyan-400 text-[#080A12] font-bold shadow-[0_0_12px_rgba(0,229,255,0.3)]" 
                : "bg-[#161C2E] border border-[#1F263B] text-gray-400 hover:text-white hover:border-gray-500"
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

    </div>

    <!-- Projects Grid Container -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.map((project) => (
        <div 
          class="project-item"
          data-category={project.data.category}
          data-search={`${project.data.title} ${project.data.description} ${project.data.tags.join(' ')} ${project.data.problem}`.toLowerCase()}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <!-- Empty Results Message -->
    <div id="no-projects-found" class="hidden py-16 text-center rounded-xl bg-[#111522]/40 border border-[#1F263B]">
      <div class="text-cyan-400 font-mono text-base mb-1">// ZERO MATCHES</div>
      <p class="text-sm text-gray-400">Không tìm thấy dự án nào khớp với từ khóa hoặc bộ lọc đã chọn.</p>
    </div>

  </div>

</BaseLayout>

<script>
  const searchInput = document.getElementById('project-search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
  const noResults = document.getElementById('no-projects-found');

  let activeCategory = 'All';
  let searchQuery = '';

  function applyFilter() {
    let visibleCount = 0;

    projectItems.forEach((item) => {
      const itemCat = item.getAttribute('data-category') || '';
      const itemSearch = item.getAttribute('data-search') || '';

      const matchCategory = activeCategory === 'All' || itemCat.toLowerCase() === activeCategory.toLowerCase();
      const matchSearch = searchQuery === '' || itemSearch.includes(searchQuery);

      if (matchCategory && matchSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Handle Search Input
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilter();
    });
  }

  // Handle Category Buttons
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-cyan-400', 'text-[#080A12]', 'font-bold', 'shadow-[0_0_12px_rgba(0,229,255,0.3)]');
        b.classList.add('bg-[#161C2E]', 'border', 'border-[#1F263B]', 'text-gray-400');
      });

      btn.classList.add('bg-cyan-400', 'text-[#080A12]', 'font-bold', 'shadow-[0_0_12px_rgba(0,229,255,0.3)]');
      btn.classList.remove('bg-[#161C2E]', 'border-[#1F263B]', 'text-gray-400');

      activeCategory = btn.getAttribute('data-category') || 'All';
      applyFilter();
    });
  });
</script>
