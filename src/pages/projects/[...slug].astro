---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map(p => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const statusColor: Record<string, string> = {
  Completed: 'var(--lime)',
  'In Progress': '#f59e0b',
  Archived: 'var(--text-low)',
};
const catColor: Record<string, string> = {
  Web:   'var(--cyan)',
  Cloud: 'var(--violet)',
  AI:    'var(--lime)',
  Other: 'var(--text-low)',
};
---

<BaseLayout title={`${data.title} — Dự Án`} description={data.description} image={data.thumbnail}>

  <div class="max-w-3xl mx-auto space-y-10 py-4">

    <!-- Back -->
    <a href={`${baseUrl}/projects`}
       style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
       class="inline-flex items-center gap-1.5 hover:text-white transition-colors">
      ← Danh mục dự án
    </a>

    <!-- Header card -->
    <div class="card p-7 space-y-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="pill" style={`color:${catColor[data.category]};border-color:rgba(255,255,255,0.1);background:var(--bg-base);`}>
          {data.category}
        </span>
        <span style={`font-family:var(--font-mono);font-size:12px;color:${statusColor[data.status]};`}>
          ● {data.status}
        </span>
      </div>

      <h1 style="font-family:var(--font-heading);font-size:clamp(1.5rem,4vw,2.2rem);font-weight:900;color:var(--text-high);">
        {data.title}
      </h1>

      <p style="font-size:15px;color:var(--text-mid);line-height:1.75;">{data.description}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-lg space-y-1" style="background:var(--bg-base);border:1px solid var(--border);">
          <p style="font-family:var(--font-mono);font-size:10.5px;font-weight:600;color:var(--cyan);text-transform:uppercase;letter-spacing:0.08em;">
            Vấn Đề Giải Quyết
          </p>
          <p style="font-size:13px;color:var(--text-mid);line-height:1.65;">{data.problem}</p>
        </div>
        <div class="p-4 rounded-lg space-y-1" style="background:var(--bg-base);border:1px solid var(--border);">
          <p style="font-family:var(--font-mono);font-size:10.5px;font-weight:600;color:var(--violet);text-transform:uppercase;letter-spacing:0.08em;">
            Vai Trò
          </p>
          <p style="font-size:13px;color:var(--text-mid);line-height:1.65;">{data.role}</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-1.5">
        {data.tags.map(t => <Tag text={t} variant="cyan" size="md" />)}
      </div>

      <div class="flex items-center gap-3 pt-1">
        {data.githubUrl
          ? <a href={data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:13px;">GitHub ↗</a>
          : <span class="pill">Repo Private</span>
        }
        {data.demoUrl
          ? <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary" style="font-size:13px;">Live Demo ↗</a>
          : <span class="pill">Demo Soon</span>
        }
      </div>
    </div>

    <!-- Thumbnail -->
    {data.thumbnail && (
      <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border);aspect-ratio:16/9;">
        <img src={data.thumbnail} alt={data.title} class="w-full h-full object-cover"/>
      </div>
    )}

    <!-- Markdown body -->
    <div class="card p-7 sm:p-10 prose-cyber">
      <Content />
    </div>

    <!-- Bottom nav -->
    <div class="pt-4 flex items-center justify-between" style="border-top:1px solid var(--border);">
      <a href={`${baseUrl}/projects`}
         style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
         class="hover:text-white transition-colors">← Danh mục</a>
      <a href="#top"
         style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
         class="hover:text-white transition-colors">↑ Đầu trang</a>
    </div>
  </div>
</BaseLayout>
