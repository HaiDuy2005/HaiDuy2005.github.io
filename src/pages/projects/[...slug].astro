---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectsUrl = `${baseUrl}/projects`;

const statusBadgeStyles = {
  Completed: 'text-emerald-400 border-emerald-500/40 bg-emerald-950/30',
  'In Progress': 'text-amber-400 border-amber-500/40 bg-amber-950/30',
  Archived: 'text-gray-400 border-gray-600/40 bg-gray-900/40',
};
---

<BaseLayout 
  title={`${data.title} — Chi Tiết Đồ Án`}
  description={data.description}
  image={data.thumbnail}
>

  <div class="max-w-4xl mx-auto space-y-10">
    
    <!-- Top Back Navigation -->
    <div>
      <a 
        href={projectsUrl}
        class="inline-flex items-center gap-2 text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <span>←</span>
        <span>TRỞ VỀ DANH MỤC DỰ ÁN</span>
      </a>
    </div>

    <!-- Project Header & Meta Card -->
    <div class="rounded-xl bg-[#111522]/90 border border-[#1F263B] p-6 sm:p-8 backdrop-blur-md space-y-6">
      
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-md text-xs font-mono font-bold uppercase tracking-wider bg-cyan-950/40 border border-cyan-500/40 text-cyan-300">
            {data.category}
          </span>
          <span class:list={["px-2.5 py-0.5 rounded text-xs font-mono border", statusBadgeStyles[data.status]]}>
            ● {data.status}
          </span>
        </div>

        <!-- Links -->
        <div class="flex items-center gap-3">
          {data.githubUrl ? (
            <a 
              href={data.githubUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg bg-[#161C2E] border border-gray-600 text-gray-200 hover:text-white hover:border-cyan-400 text-xs font-mono flex items-center gap-1.5 transition-colors"
            >
              <span>GitHub Repo</span>
              <span>↗</span>
            </a>
          ) : (
            <span class="px-3 py-1 rounded bg-[#161C2E]/60 border border-[#1F263B] text-[11px] font-mono text-gray-500">
              Repository: Private
            </span>
          )}

          {data.demoUrl ? (
            <a 
              href={data.demoUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-[#080A12] text-xs font-mono font-bold flex items-center gap-1.5 transition-colors"
            >
              <span>Live Demo</span>
              <span>↗</span>
            </a>
          ) : (
            <span class="px-3 py-1 rounded bg-[#161C2E]/60 border border-[#1F263B] text-[11px] font-mono text-gray-500">
              Demo: Coming Soon
            </span>
          )}
        </div>
      </div>

      <h1 class="text-2xl sm:text-4xl font-heading font-black text-white">
        {data.title}
      </h1>

      <p class="text-base text-gray-300 leading-relaxed font-sans">
        {data.description}
      </p>

      <!-- Problem & Role Key Blocks -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[#1F263B]">
        <div class="p-4 rounded-lg bg-[#0C101A] border border-[#1F263B] space-y-1">
          <span class="text-xs font-mono text-cyan-400 font-bold block uppercase tracking-wider">
            Vấn Đề Giải Quyết
          </span>
          <p class="text-xs text-gray-300 leading-relaxed">
            {data.problem}
          </p>
        </div>

        <div class="p-4 rounded-lg bg-[#0C101A] border border-[#1F263B] space-y-1">
          <span class="text-xs font-mono text-purple-400 font-bold block uppercase tracking-wider">
            Vai Trò Thực Hiện
          </span>
          <p class="text-xs text-gray-300 leading-relaxed">
            {data.role}
          </p>
        </div>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {data.tags.map((tag) => (
          <Tag text={tag} variant="cyan" size="md" />
        ))}
      </div>

    </div>

    <!-- Thumbnail Banner -->
    {data.thumbnail && (
      <div class="rounded-xl overflow-hidden border border-[#1F263B] bg-[#0A0D17] aspect-[16/9] shadow-2xl">
        <img 
          src={data.thumbnail} 
          alt={data.title} 
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Markdown Content Section -->
    <div class="rounded-xl bg-[#111522]/80 border border-[#1F263B] p-6 sm:p-10 backdrop-blur-md prose-cyber text-gray-300">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="pt-6 border-t border-[#1F263B] flex items-center justify-between">
      <a 
        href={projectsUrl}
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 font-bold"
      >
        ← XEM TOÀN BỘ DANH MỤC DỰ ÁN
      </a>
      <a 
        href="#top"
        class="text-xs font-mono text-gray-400 hover:text-white"
      >
        ↑ VỀ ĐẦU TRANG
      </a>
    </div>

  </div>

</BaseLayout>
