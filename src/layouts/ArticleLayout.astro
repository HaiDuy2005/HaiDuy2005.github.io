---
import TableOfContents from '../components/TableOfContents.astro';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { formatDate, getReadingTime } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags: string[];
  cover?: string;
  headings: { depth: number; slug: string; text: string }[];
  rawBody?: string;
}
const { title, description, pubDate, author, category, tags, cover, headings, rawBody } = Astro.props;
const readingTime = getReadingTime(rawBody);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} image={cover} article>

  <!-- Reading progress bar -->
  <div id="read-bar" class="fixed left-0 z-50 h-[3px] w-0 transition-none"
       style="top:60px;background:linear-gradient(to right,var(--cyan),var(--violet));"></div>

  <article class="max-w-5xl mx-auto">

    <!-- Back nav -->
    <div class="mb-8">
      <a href={`${baseUrl}/posts`}
         style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
         class="inline-flex items-center gap-1.5 hover:text-white transition-colors">
        ← Tất cả bài viết
      </a>
    </div>

    <!-- Article header -->
    <header class="mb-10 space-y-5 max-w-2xl">
      <div class="flex items-center gap-2">
        <span class="pill pill-violet">{category}</span>
        <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-low);">{formatDate(pubDate)}</span>
        <span style="color:var(--text-low);">·</span>
        <span style="font-family:var(--font-mono);font-size:11px;color:var(--cyan);">{readingTime}</span>
      </div>

      <h1 style="font-family:var(--font-heading);font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;color:var(--text-high);line-height:1.15;">
        {title}
      </h1>

      <p style="font-size:15px;color:var(--text-mid);line-height:1.75;">
        {description}
      </p>

      <div style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);">
        bởi <span style="color:var(--text-high);">{author}</span>
      </div>

      <div class="flex flex-wrap gap-1.5">
        {tags.map(tag => <Tag text={tag} variant="violet" size="md" />)}
      </div>
    </header>

    <!-- Cover image -->
    {cover && (
      <div class="mb-10 rounded-xl overflow-hidden" style="border:1px solid var(--border);aspect-ratio:21/9;">
        <img src={cover} alt={title} class="w-full h-full object-cover"/>
      </div>
    )}

    <!-- Content grid: prose + sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

      <!-- Prose -->
      <div class="lg:col-span-8 prose-cyber">
        <slot />

        <!-- Sample post notice -->
        <div class="mt-12 p-4 rounded-lg" style="background:var(--bg-raised);border:1px solid var(--border);font-family:var(--font-mono);font-size:12px;color:var(--text-low);">
          <span style="color:var(--cyan);font-weight:600;">📝 Bài viết mẫu:</span>
          Chỉnh sửa nội dung tại <code style="color:var(--cyan);">src/content/posts/</code>.
        </div>
      </div>

      <!-- Sidebar TOC -->
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-24 space-y-4">
          <div class="card p-5">
            <TableOfContents headings={headings} />
          </div>

          <!-- Share -->
          <div class="card p-4 space-y-2">
            <p class="section-label">Share</p>
            <button id="share-btn" type="button" class="btn-ghost w-full justify-center" style="font-size:12px;padding:8px;">
              Sao chép liên kết
            </button>
          </div>
        </div>
      </aside>
    </div>

    <!-- Bottom nav -->
    <div class="mt-16 pt-6 flex items-center justify-between"
         style="border-top:1px solid var(--border);">
      <a href={`${baseUrl}/posts`}
         style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
         class="hover:text-white transition-colors">← Bài viết khác</a>
      <a href="#top"
         style="font-family:var(--font-mono);font-size:12px;color:var(--text-low);"
         class="hover:text-white transition-colors">↑ Đầu trang</a>
    </div>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('read-bar');
  if (bar) {
    window.addEventListener('scroll', () => {
      const pct = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
      bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
    });
  }
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        shareBtn.textContent = 'Đã sao chép!';
        setTimeout(() => { shareBtn.textContent = 'Sao chép liên kết'; }, 2000);
      } catch {}
    });
  }
</script>
